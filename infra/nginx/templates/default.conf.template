server {
  listen 443 ssl;
  server_name localhost;

  ssl_certificate /certs/mtls-server.crt;
  ssl_certificate_key /certs/mtls-server.key;
  ssl_client_certificate /certs/mtls-ca.crt;
  ssl_verify_client on;
  ssl_protocols TLSv1.2 TLSv1.3;

  location / {
    proxy_pass http://gateway:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header x-gateway-client-cert-verified $ssl_client_verify;
    proxy_set_header x-gateway-client-cert-sha256 ${DEV_MTLS_CERT_FINGERPRINT};
  }
}
