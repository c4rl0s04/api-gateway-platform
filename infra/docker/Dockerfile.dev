FROM node:22.19.0-alpine

RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/pki/package.json packages/pki/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/gateway-core/package.json packages/gateway-core/package.json
COPY packages/management-api/package.json packages/management-api/package.json
COPY packages/admin-panel/package.json packages/admin-panel/package.json
RUN npm ci

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/pki packages/pki
COPY packages/database packages/database
COPY packages/gateway-core packages/gateway-core
COPY mock-backend.js mock-backend.json ./

RUN npm run build --workspace=packages/shared \
    && npm run build --workspace=packages/pki \
    && npm run build --workspace=packages/database \
    && npm run build --workspace=packages/gateway-core

CMD ["node", "packages/gateway-core/dist/index.js"]
