generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeploymentStage {
  qual
  pprod
  prod
}

enum DeploymentRegion {
  ce
  es
  de
  be
  fr
  us
  uk
  jp
  br
  kr
}

enum EndpointMode {
  forward
  local
}

enum CredentialAuthMethod {
  apiKey
  clientSecret
  jwtBearer
  mtls
}

enum AuthorizationStatus {
  pending
  approved
  revoked
}

enum PublicKeyAlgorithm {
  RS256
}

enum CertificateAuthorityKind {
  managed
  external
}

enum CertificateAuthorityStatus {
  draft
  active
  retiring
  revoked
}

enum CertificateSource {
  managed
  external
  legacy
}

enum AdminRole {
  platformAdmin
  organizationAdmin
  viewer
}

/// Root tenant of the system. Owns logical proxies, products and applications.
model Organization {
  id                     String                 @id @default(uuid())
  name                   String
  createdAt              DateTime               @default(now())
  proxies                ApiProxy[]
  apps                   DeveloperApp[]
  products               ApiProduct[]
  certificateAuthorities CertificateAuthority[]
  adminMemberships       AdminMembership[]
  auditEvents            AuditEvent[]
}

/// Global deployment target selected from closed stage and region values.
model Environment {
  id          String            @id @default(uuid())
  stage       DeploymentStage
  region      DeploymentRegion
  deployments ProxyDeployment[]
  products    ApiProduct[]
  createdAt   DateTime          @default(now())

  @@unique([stage, region])
}

/// Logical API definition owned by an organization.
model ApiProxy {
  id             String            @id @default(uuid())
  name           String
  basePath       String            @unique
  active         Boolean           @default(true)
  systemManaged  Boolean           @default(false)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  endpoints      Endpoint[]
  deployments    ProxyDeployment[]
  products       ApiProduct[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

/// Concrete deployment of a logical proxy into one environment.
model ProxyDeployment {
  id              String      @id @default(uuid())
  proxyId         String
  proxy           ApiProxy    @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  environmentId   String
  environment     Environment @relation(fields: [environmentId], references: [id])
  /// Backend origin for this deployment. Ex: "https://accounts-qual.example.com".
  upstreamBaseUrl String?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([proxyId, environmentId])
}

/// Individual endpoint within a proxy.
model Endpoint {
  id         String           @id @default(uuid())
  mode       EndpointMode     @default(forward)
  /// Public route suffix relative to the proxy basePath.
  path       String
  /// Backend path relative to ProxyDeployment.upstreamBaseUrl.
  targetPath String?
  proxyId    String
  proxy      ApiProxy         @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  policies   EndpointPolicy[]
  createdAt  DateTime         @default(now())
}

/// Policy applied to a specific endpoint.
/// `config` is free JSON — each policy type has its own parameters.
model EndpointPolicy {
  id         String   @id @default(uuid())
  /// Value of the closed PolicyType catalog from @api-gateway/shared.
  type       String
  order      Int
  enabled    Boolean  @default(true)
  /// Specific policy parameters. Ex: { "limit": 100, "windowSeconds": 60 }
  config     Json     @default("{}")
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

/// A consumable bundle of API Proxies.
/// Products are the authorization bridge between developer apps and proxies.
/// A product defines which proxies a credential can access.
/// An empty environments relation means the product is available everywhere.
model ApiProduct {
  id               String                   @id @default(uuid())
  name             String
  active           Boolean                  @default(true)
  scopes           String[]                 @default([])
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id])
  /// The proxies bundled into this product.
  proxies          ApiProxy[]
  /// Optional allowlist. Empty means all environments.
  environments     Environment[]
  /// Credential-specific grants, including approval state and scopes.
  credentialGrants CredentialProductGrant[]
  createdAt        DateTime                 @default(now())
}

/// Developer application registered in the gateway.
/// Represents an external partner or internal team consuming APIs.
model DeveloperApp {
  id             String              @id @default(uuid())
  name           String
  status         AuthorizationStatus @default(approved)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  credentials    AppCredential[]
  createdAt      DateTime            @default(now())
}

/// Access credential for a DeveloperApp.
/// Stores the consumerKey (Client ID) and an optional salted secret hash.
/// Generated client secrets are returned once and cannot be read back.
/// A single app can have multiple credentials for key rotation without downtime.
model AppCredential {
  id                   String                   @id @default(uuid())
  appId                String
  app                  DeveloperApp             @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// The API Key / Client ID. Sent by the client in the x-api-key header.
  consumerKey          String                   @unique
  /// Scrypt hash. The generated secret is returned only once.
  consumerSecretHash   String?
  authMethods          CredentialAuthMethod[]   @default([])
  status               AuthorizationStatus      @default(approved)
  attributes           Json                     @default("{}")
  issuedAt             DateTime                 @default(now())
  expiresAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  productGrants        CredentialProductGrant[]
  publicKeys           AppPublicKey[]
  certificates         AppCertificate[]
  certificateIssuances CertificateIssuance[]
}

model CredentialProductGrant {
  id           String              @id @default(uuid())
  credentialId String
  credential   AppCredential       @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  productId    String
  product      ApiProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  status       AuthorizationStatus @default(pending)
  scopes       String[]            @default([])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([credentialId, productId])
}

model AppPublicKey {
  id           String              @id @default(uuid())
  credentialId String
  credential   AppCredential       @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  kid          String
  algorithm    PublicKeyAlgorithm  @default(RS256)
  jwk          Json
  status       AuthorizationStatus @default(approved)
  validFrom    DateTime            @default(now())
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([credentialId, kid])
}

model AppCertificate {
  id                String                @id @default(uuid())
  credentialId      String
  credential        AppCredential         @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  authorityId       String?
  authority         CertificateAuthority? @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  fingerprintSha256 String                @unique
  certificatePem    String?
  chainPem          String?
  source            CertificateSource     @default(legacy)
  serialNumber      String?
  subject           String?
  issuer            String?
  status            AuthorizationStatus   @default(approved)
  validFrom         DateTime              @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  revocationReason  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  issuance          CertificateIssuance?

  @@index([authorityId])
}

/// A trust anchor owned by one organization. Managed authorities can issue
/// client certificates; external authorities contribute public trust only.
model CertificateAuthority {
  id                 String                     @id @default(uuid())
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name               String
  kind               CertificateAuthorityKind
  status             CertificateAuthorityStatus @default(draft)
  isDefaultIssuer    Boolean                    @default(false)
  certificatePem     String
  chainPem           String?
  fingerprintSha256  String                     @unique
  subject            String
  serialNumber       String
  validFrom          DateTime
  expiresAt          DateTime
  keyRef             String?
  crlPem             String?
  crlThisUpdate      DateTime?
  crlNextUpdate      DateTime?
  crlDistributionUrl String?
  certificates       AppCertificate[]
  issuances          CertificateIssuance[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([organizationId, status])
}

/// Audit record for a CSR signing attempt. The client private key never enters
/// this model or any other platform persistence surface.
model CertificateIssuance {
  id            String               @id @default(uuid())
  authorityId   String
  authority     CertificateAuthority @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  credentialId  String
  credential    AppCredential        @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  csrSha256     String
  requestedDays Int
  certificateId String?              @unique
  certificate   AppCertificate?      @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  errorCode     String?
  createdAt     DateTime             @default(now())
  completedAt   DateTime?

  @@index([authorityId, createdAt])
  @@index([credentialId, createdAt])
}

/// Maps an OIDC principal to a platform-wide or organization-scoped role.
/// `scopeKey` is "platform" for platform admins and the organization ID for
/// organization-scoped roles, making uniqueness explicit even when the
/// organization relation is null.
model AdminMembership {
  id             String        @id @default(uuid())
  oidcIssuer     String
  oidcSubject    String
  role           AdminRole
  scopeKey       String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String?
  email          String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([oidcIssuer, oidcSubject, scopeKey])
  @@index([organizationId, role])
}

/// Append-only record of security-sensitive control-plane operations.
model AuditEvent {
  id             String        @id @default(uuid())
  actorIssuer    String
  actorSubject   String
  actorRole      AdminRole
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}
