generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant raíz del sistema. Cada organización tiene sus propios entornos y proxies.
model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  environments Environment[]
}

/// Entorno de despliegue dentro de una organización.
/// Los proxies se despliegan siempre en un entorno concreto.
model Environment {
  id             String       @id @default(uuid())
  name           String       // "dev" | "staging" | "prod"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  proxies        ApiProxy[]
}

/// API Proxy: contenedor lógico con un basePath público único.
/// Agrupa endpoints con rutas específicas que apuntan a backends reales.
model ApiProxy {
  id            String     @id @default(uuid())
  name          String
  /// Prefijo público único. Ej: "/es/banking/v1"
  basePath      String     @unique
  active        Boolean    @default(true)
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id])
  endpoints     Endpoint[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// Endpoint individual dentro de un proxy.
/// Define el path exacto (con posibles parámetros como ":id")
/// y la URL del backend al que se reenvía la request.
model Endpoint {
  id        String           @id @default(uuid())
  /// Sufijo de ruta relativo al basePath. Admite parámetros: "/accounts/:id"
  path      String
  /// URL completa del backend para este endpoint. Ej: "http://backend:8080/accounts/:id"
  targetUrl String
  proxyId   String
  proxy     ApiProxy         @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  policies  EndpointPolicy[]
  createdAt DateTime         @default(now())
}

/// Política aplicada a un endpoint concreto.
/// `config` es JSON libre — cada tipo de política tiene sus propios parámetros.
/// Semana 3 rellenará estas filas con configuraciones reales.
model EndpointPolicy {
  id         String   @id @default(uuid())
  /// Valor de PolicyType: "api-key-auth" | "rate-limit" | "jwt-auth" | etc.
  type       String
  order      Int
  enabled    Boolean  @default(true)
  /// Parámetros específicos de la política. Ej: { "limit": 100, "windowSeconds": 60 }
  config     Json     @default("{}")
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}
