generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Root tenant of the system. Each organization has its own environments and proxies.
model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  environments Environment[]
}

/// Deployment environment within an organization.
/// Proxies are always deployed in a specific environment.
model Environment {
  id             String       @id @default(uuid())
  name           String       // "dev" | "staging" | "prod"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  proxies        ApiProxy[]
}

/// API Proxy: logical container with a unique public basePath.
/// Groups endpoints with specific routes pointing to real backends.
model ApiProxy {
  id            String     @id @default(uuid())
  name          String
  /// Unique public prefix. Ex: "/es/banking/v1"
  basePath      String     @unique
  active        Boolean    @default(true)
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id])
  endpoints     Endpoint[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// Individual endpoint within a proxy.
/// Defines the exact path (with possible parameters like ":id")
/// and the backend URL to which the request is forwarded.
model Endpoint {
  id        String           @id @default(uuid())
  /// Route suffix relative to the basePath. Supports parameters: "/accounts/:id"
  path      String
  /// Full backend URL for this endpoint. Ex: "http://backend:8080/accounts/:id"
  targetUrl String
  proxyId   String
  proxy     ApiProxy         @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  policies  EndpointPolicy[]
  createdAt DateTime         @default(now())
}

/// Policy applied to a specific endpoint.
/// `config` is free JSON — each policy type has its own parameters.
/// Week 3 will fill these rows with real configurations.
model EndpointPolicy {
  id         String   @id @default(uuid())
  /// Value of PolicyType: "api-key-auth" | "rate-limit" | "jwt-auth" | etc.
  type       String
  order      Int
  enabled    Boolean  @default(true)
  /// Specific policy parameters. Ex: { "limit": 100, "windowSeconds": 60 }
  config     Json     @default("{}")
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}
