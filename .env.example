NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/apigw?schema=public"
REDIS_URL="redis://localhost:6379"
LOG_LEVEL=info
# Optional comma-separated environment IDs. Empty loads every active deployment.
GATEWAY_ENVIRONMENT_ALLOWLIST=""
OAUTH_SIGNING_KEY_ID="local-gateway-1"
# Base64-encoded PKCS#8 RSA private key. Generate locally; never commit the value.
OAUTH_SIGNING_PRIVATE_KEY_BASE64="<base64-pkcs8-rsa-private-key>"
# Immediate Envoy networks trusted to set the connection-derived fingerprint.
MTLS_TRUSTED_PROXY_CIDRS="127.0.0.0/8,::1/128"

# Standalone Management API values. Compose supplies container-specific paths.
OIDC_ISSUER="http://localhost:8081/realms/api-gateway"
OIDC_AUDIENCE="management-api"
OIDC_JWKS_URI="http://localhost:8081/realms/api-gateway/protocol/openid-connect/certs"
PKI_KEYSTORE_DIR=".local-secrets/pki/keystore"
PKI_MASTER_KEY_FILE=".local-secrets/pki/master.key"
PKI_TRUST_BUNDLE_FILE=".local-secrets/pki/trust-bundle.pem"
PKI_CRL_BUNDLE_FILE=".local-secrets/pki/crl-bundle.pem"
PKI_SDS_TRIGGER_FILE="infra/envoy/sds/client-validation.yaml"
