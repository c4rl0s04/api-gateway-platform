NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/apigw?schema=public"
REDIS_URL="redis://localhost:6379"
LOG_LEVEL=info
# Required outside tests. Selects one of the 30 closed stage/region environments.
GATEWAY_ENVIRONMENT_ID="env-qual-es"
OAUTH_ISSUER="http://localhost:3000"
OAUTH_TOKEN_ENDPOINT_AUDIENCE="http://localhost:3000/oauth/token"
OAUTH_SIGNING_KEY_ID="local-gateway-1"
# Base64-encoded PKCS#8 RSA private key. Generate locally; never commit the value.
OAUTH_SIGNING_PRIVATE_KEY_BASE64="<base64-pkcs8-rsa-private-key>"
# Immediate ingress networks trusted to set normalized client-certificate headers.
MTLS_TRUSTED_PROXY_CIDRS="127.0.0.0/8,::1/128"
